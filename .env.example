# =============================================================
# Server-Face Microservice - Environment Variables Example
# Sao chép file này thành .env và điền giá trị thực tế vào
# Copy this file to .env and fill in the actual values
# =============================================================

# Application Configuration
APP_NAME="InsightFace Microservice"
MODEL_NAME="buffalo_l"
SIMILARITY_THRESHOLD=0.45
# Passive liveness model must be provisioned locally; the app never downloads it.
LIVENESS_MODEL_PATH=/models/liveness.onnx
LIVENESS_THRESHOLD=0.80
LIVENESS_INPUT_SIZE='[80,80]'
LIVENESS_LIVE_CLASS_INDEX=1
PORT=8000
HOST="0.0.0.0"

# CORS - Cho phép các origin kết nối (phân cách bởi dấu phẩy)
# LINK_COR=http://localhost:3000,https://your-frontend.com

# ------------------------------------------------------------------
# MongoDB Configuration
# Khi chạy cùng Docker Compose: mongodb://mongodb/<db_name>
# Khi kết nối Host từ container:  mongodb://host.docker.internal:<port>/<db_name>
# ------------------------------------------------------------------
MONGODB_URI=mongodb://mongodb/face
MONGODB_USER=your_mongo_username
MONGODB_PASSWORD=your_mongo_password
MONGODB_AUTH_SOURCE=admin

# ------------------------------------------------------------------
# Admin Panel Credentials
# Thay đổi mật khẩu mặc định trước khi deploy lên production!
# ------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# Thời gian sống của phiên đăng nhập admin (giây)
ADMIN_SESSION_TTL_SECONDS=86400
# Bật cờ Secure cho cookie phiên khi deploy sau HTTPS
ADMIN_COOKIE_SECURE=false
# Tên cookie phiên admin
ADMIN_SESSION_COOKIE=admin_session

# ------------------------------------------------------------------
# Integration API
# ------------------------------------------------------------------
# API key cố định cho các API quản lý đăng ký khuôn mặt (header X-API-Key)
FACE_API_KEY=example-integration-api-key

# Timeout chọn server MongoDB (ms) - giúp app trả 503 nhanh khi Mongo không sẵn sàng
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# ------------------------------------------------------------------
# Video Liveness Challenges (turn_left / turn_right / blink)
# ------------------------------------------------------------------
# Thời gian sống của challenge (giây) - mỗi challenge chỉ dùng được 1 lần
VIDEO_LIVENESS_CHALLENGE_TTL_SECONDS=60
# Kích thước video tối đa (bytes)
VIDEO_LIVENESS_MAX_BYTES=10485760
# Thời lượng video tối đa (giây)
VIDEO_LIVENESS_MAX_SECONDS=5
# Số khung hình hợp lệ tối thiểu cần lấy mẫu
VIDEO_LIVENESS_MIN_FRAMES=12
# Tần suất lấy mẫu khung hình (fps)
VIDEO_LIVENESS_SAMPLE_FPS=8
# Ngưỡng góc quay đầu tối thiểu (độ) để tính là turn hợp lệ
VIDEO_LIVENESS_TURN_DEGREES=15
# Ngưỡng lệch góc coi là "về lại vị trí trung tính" (độ)
VIDEO_LIVENESS_NEUTRAL_DEGREES=5
# Tỉ lệ EAR/baseline được coi là mắt đã nhắm
VIDEO_LIVENESS_BLINK_CLOSED_RATIO=0.5
# Tỉ lệ EAR/baseline được coi là mắt đã mở lại
VIDEO_LIVENESS_BLINK_OPEN_RATIO=0.8
# Ngưỡng điểm motion tối thiểu để verified=true
VIDEO_LIVENESS_MOTION_THRESHOLD=0.6

# ------------------------------------------------------------------
# Recognition accuracy
# ------------------------------------------------------------------
# Model pack is set at the top of this file (buffalo_l by default).
#
# WARNING: changing MODEL_NAME invalidates every stored embedding - they live in
# a different vector space. Run scripts/reembed_registry.py --apply afterwards
# (needs STORE_ENROLLMENT_IMAGES), or have everyone re-enrol.

# 1:N identification. Stricter than SIMILARITY_THRESHOLD because a probe is
# scored against every enrolled employee at once. Calibrate both with
# scripts/benchmark_recognition.py.
IDENTIFY_THRESHOLD=0.55
# Minimum lead the best match must have over the runner-up; below this the
# result is "ambiguous" rather than a guess.
IDENTIFY_MARGIN=0.10
# Frames the same identity must win in a row before it is committed.
IDENTIFY_CONSECUTIVE_FRAMES=3
# Seconds before the same person can generate another event.
IDENTIFY_COOLDOWN_SECONDS=30
IDENTIFY_MIN_FACE_PX=80
IDENTIFY_MIN_DET_SCORE=0.6

# Enrollment quality gate (registration only - never applied at verification,
# so nobody gets locked out by bad office lighting).
QUALITY_GATE_ENABLED=true
QUALITY_MIN_DET_SCORE=0.7
QUALITY_MIN_FACE_PX=80
QUALITY_MIN_BLUR_VARIANCE=60
QUALITY_MIN_BRIGHTNESS=40
QUALITY_MAX_BRIGHTNESS=220
QUALITY_MAX_YAW_DEGREES=25
QUALITY_MAX_ROLL_DEGREES=20

# Keep original enrollment images in GridFS so embeddings can be rebuilt after a
# model change. OFF by default: these are biometric images - decide on a
# retention policy before enabling.
STORE_ENROLLMENT_IMAGES=true
ENROLLMENT_IMAGE_RETENTION_DAYS=0

# Require passive liveness on /face/verify-employee. Off by default so existing
# integrations keep working; turn on once clients send live captures.
REQUIRE_LIVENESS_ON_VERIFY=false

# ------------------------------------------------------------------
# Continuous 1:N identification (WS /api/v1/face/stream)
# ------------------------------------------------------------------
STREAM_ENABLED=true
STREAM_MAX_FRAME_BYTES=2097152
STREAM_LIVENESS_ENABLED=true

# Outbound bridge to the ERP server. Leave ERP_WS_URL unset to keep it off.
# ERP_WS_URL=wss://erp.example.com/ws/attendance
# ERP_WS_API_KEY=example-erp-key
ERP_WS_QUEUE_MAX=1000
ERP_WS_BACKOFF_MIN_SECONDS=1
ERP_WS_BACKOFF_MAX_SECONDS=60
ERP_WS_PING_INTERVAL_SECONDS=20
